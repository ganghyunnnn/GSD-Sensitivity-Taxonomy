    affiliation: "Korea Aerospace Research Institute"
  - family-names: Lee
    given-names: Dong-Ho
    orcid: "https://orcid.org/0000-0002-7360-3027"
    affiliation: "Korea Aerospace Research Institute"
license: Apache-2.0
repository-code: "https://github.com/ganghyunnnn/GSD-Sensitivity-Taxonomy"
url: "https://huggingface.co/datasets/ganghyunnnn/GSD-Sensitivity-Taxonomy-Labels"
keywords:
  - remote sensing
  - visual question answering
  - ground sample distance
  - vision-language models
  - benchmark taxonomy
